      "text": "好嘞。",
      "speaker": "1",
      "is_up": true
    },
    {
      "start": 13.79,
      "end": 15.63,
      "text": "不错不错，来，我把镜头挪过来啊。",
      "speaker": "1",
      "is_up": true
